

from dataclasses import dataclass
from pathlib import Path
from dotenv import dotenv_values

@dataclass(frozen=True)
class PipelineConfig:
    input_path: Path
    output_dir: Path

def load_config_customers():
    base_dir = Path(__file__).resolve().parent
    env_path = base_dir / ".env"
    with env_path.open("r", encoding="utf-8", newline="") as file:
        properties = dotenv_values(stream=file, interpolate=False)
        input_path = properties.get("INPUT_PATH_CUSTOMERS")
        output_dir = properties.get("OUTPUT_DIR_CUSTOMERS")
    return PipelineConfig(
        base_dir / input_path,
        base_dir / output_dir
    )

